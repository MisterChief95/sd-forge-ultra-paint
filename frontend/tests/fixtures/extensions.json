[
  {
    "id": "sd-forge-nag",
    "title": "Normalized Attention Guidance",
    "scriptTitle": "Normalized Attention Guidance",
    "description": "Guides away from the Negative Prompt inside attention; works at CFG 1.",
    "canEnable": true,
    "inputs": [
      {
        "key": "scale",
        "label": "Scale",
        "type": "number",
        "default": 5.0,
        "min": 1.0,
        "max": 20.0,
        "step": 0.1
      },
      {
        "key": "tau",
        "label": "Tau",
        "type": "number",
        "default": 2.5,
        "min": 1.0,
        "max": 10.0,
        "step": 0.1
      },
      {
        "key": "alpha",
        "label": "Alpha",
        "type": "number",
        "default": 0.25,
        "min": 0.0,
        "max": 1.0,
        "step": 0.01
      },
      {
        "key": "sigma_end",
        "label": "Sigma End",
        "type": "number",
        "default": 0.0,
        "min": 0.0,
        "max": 1.0,
        "step": 0.01,
        "info": "stop NAG below this sigma; higher is faster"
      }
    ]
  }
]
